extends "res://tests/psychic_parity/input.gd"
func run() -> void:
 var base := OS.get_environment("GAME127_ROOT");var saved: Dictionary=RulesJson.normalize(WorldOriginLore.read_json(base.path_join("saved.json")))
 for cls in ["psychic-warrior","divine-mind"]:
  var original: Dictionary=saved.records[cls+"1"];var before := RulesJson.digest(original)
  var editor := BuildEditor.new();add_child(editor);editor.setup(original,false);editor.class_loadout();editor.refresh_preview()
  check(editor.class_id==cls and editor.preview.ok,"actual production creator first open "+cls)
  check(editor.class_options().has(cls) and not editor.class_options().has("cognition-adept"),"base classes visible; prestige never a starting choice")
  var powers: OptionButton=editor.career_pickers[cls+"-power-1"]
  check(powers.item_count>1,"real persistent power choices")
  for i in powers.item_count:
   if int(editor.source.definition("psychic_powers",str(powers.get_item_metadata(i))).tier)>1:check(powers.is_item_disabled(i),"higher tier unavailable at birth")
  if cls=="divine-mind":
   choose(editor.career_pickers["divine-mind-mantle"],"energy");choose(editor.career_pickers["divine-mind-power-1"],"power-kinetic-bolt")
   choose(editor.career_pickers["divine-mind-doctrine"],"assault")
   check(editor.preview.ok,"actual mantle, power and assault choice legal")
   choose(editor.career_pickers["divine-mind-mantle"],"body")
   choose(editor.career_pickers["divine-mind-power-1"],"power-force-screen")
   choose(editor.career_pickers["divine-mind-doctrine"],"bulwark")
   check(editor.preview.ok,"actual body/support/doctrine alternatives change legal build")
  else:
   choose(editor.career_pickers["psychic-warrior-power-1"],"power-force-screen")
   check(editor.preview.ok,"actual warrior support choice legal")
  check(RulesJson.digest(original)==before,"creator does not mutate existing save")
  editor.queue_free()
 var advance := BuildEditor.new();add_child(advance);advance.setup(saved.records.cognition0,true)
 choose(advance.class_picker,"cognition-adept")
 check(advance.preview.ok and advance.preview.candidate.advancement_history.back().class_id=="cognition-adept","actual eligible path selected manually")
 check(saved.records.cognition0.advancement_history.size()==8,"eligibility and preview never auto-assign prestige")
 advance.queue_free()
 var ui: Control=load("res://tests/spell_repertoires/combat_input_probe.gd").new();PartyService.handoff={};add_child(ui);ui.set_process(false)
 var b: Dictionary=saved.battles["ready-warrior8"].duplicate(true)
 ui.engine=TacticalAuras.new(b.units.a.record);ui.state={"first_adventure":{"battle":b},"party_ids":["a","b","c"],"party":{"members":[]}};ui.mode="attack";ui.refresh()
 var before := RulesJson.digest(b)
 choose(ui.find_child("PsychicPowerSelector",true,false),"power-kinetic-bolt")
 choose(ui.find_child("PsychicAugmentationSelector",true,false),"power-kinetic-bolt-aug2")
 check(ui.action_buttons.has("power-kinetic-bolt-aug2") and not ui.action_buttons["power-kinetic-bolt-aug2"].disabled,"actual legal augmented manifestation control")
 ui.action_buttons["power-kinetic-bolt-aug2"].pressed.emit();var position: Array=b.units["bandit-blade"].position
 check(ui.tiles[str(position)].target_tile,"actual power target hitbox")
 ui.tiles[str(position)].pressed.emit()
 check(ui.sent.get("kind")=="power-kinetic-bolt-aug2" and ui.sent.get("target")=="bandit-blade","actual selector/button/tile produces correct intent")
 check(RulesJson.digest(b)==before,"preview changes no RNG, resources or battle state")
 for key in ["reach-cognition","bow-cognition"]:
  b=saved.battles[key].duplicate(true);ui.engine=TacticalAuras.new(b.units.a.record);ui.state.first_adventure.battle=b;ui.mode="cognition-strike-1";ui.refresh()
  check(ui.action_buttons["cognition-strike-1"].disabled,"actual illegal nonadjacent/ranged prestige action disabled "+key)
  check("range 1" in ui.action_buttons["cognition-strike-1"].text,"actual adjacent action caption respects descriptor "+key)
  check(not ui.tiles[str(b.units["bandit-blade"].position)].target_tile,"no illegal highlight "+key)
 b=saved.battles["reach-cognition"].duplicate(true);b.units["bandit-blade"].position=[2,1];ui.engine=TacticalAuras.new(b.units.a.record);b=ui.engine.seal(b);ui.state.first_adventure.battle=b;ui.refresh()
 check(not ui.action_buttons["cognition-strike-1"].disabled,"actual adjacent prestige action available")
 ui.tiles[str(b.units["bandit-blade"].position)].pressed.emit()
 var used := ui.engine.command(b,{"actor_id":"a","revision":b.revision,"kind":ui.sent.get("kind",""),"target_id":ui.sent.get("target","")})
 check(used.ok,"actual prestige targeting intent accepted")
 b=saved.battles.aura8.duplicate(true);ui.engine=TacticalAuras.new(b.units.a.record);ui.state.first_adventure.battle=b;ui.refresh()
 check(ui.action_buttons.has("divine-mind-aura-bulwark") and not ui.action_buttons["divine-mind-aura-bulwark"].disabled,"actual aura switch control available")
 ui.action_buttons["divine-mind-aura-bulwark"].pressed.emit()
 check(ui.sent.get("kind")=="divine-mind-aura-bulwark" and ui.sent.get("target")=="a","self aura uses real production dispatch")
 check(ui.engine.command(b,{"actor_id":"a","revision":b.revision,"kind":ui.sent.get("kind",""),"target_id":ui.sent.get("target","")}).ok,"actual switch intent accepted")
 ui.queue_free()
 FileAccess.open(base.path_join("input-proof.json"),FileAccess.WRITE).store_string(JSON.stringify({"checks":checks,"failures":failures,"scope":"Actual Godot production creator/advancement, mantle/doctrine/power/augmentation controls and tactical targeting. Human Windows usability acceptance separate."}))
 get_tree().quit(1 if failures else 0)
